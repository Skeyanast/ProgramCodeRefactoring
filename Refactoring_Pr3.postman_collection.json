							"listen": "prerequest",
							"script": {
								"exec": [
									"// Создаем пользователя для теста агрегации, если его нет\r",
									"if (!pm.collectionVariables.get(\"test_user_id\")) {\r",
									"    const createRequest = {\r",
									"        url: pm.collectionVariables.get(\"base_url\") + '/users',\r",
									"        method: 'POST',\r",
									"        header: { 'Content-Type': 'application/json' },\r",
									"        body: {\r",
									"            mode: 'raw',\r",
									"            raw: JSON.stringify({\r",
									"                email: 'aggregation.test@mail.ru',\r",
									"                name: 'Aggregation Test User'\r",
									"            })\r",
									"        }\r",
									"    };\r",
									"    \r",
									"    pm.sendRequest(createRequest, function (err, response) {\r",
									"        if (!err) {\r",
									"            const userData = response.json();\r",
									"            pm.collectionVariables.set(\"test_user_id\", userData.id);\r",
									"            pm.collectionVariables.set(\"test_user_email\", userData.email);\r",
									"            console.log(\"Created user for aggregation test: \" + userData.id);\r",
									"        }\r",
									"    });\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
