									"});\r",
									"\r",
									"pm.test(\"Response has user structure with ID\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData).to.have.property('id');\r",
									"    pm.expect(jsonData).to.have.property('email');\r",
									"    pm.expect(jsonData).to.have.property('name');\r",
									"});\r",
									"\r",
									"pm.test(\"User data matches request\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    const requestBody = JSON.parse(pm.request.body.raw);\r",
									"    pm.expect(jsonData.email).to.eql(requestBody.email);\r",
									"    pm.expect(jsonData.name).to.eql(requestBody.name);\r",
									"});\r",
									"\r",
									"pm.test(\"ID is numeric and positive\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.id).to.be.a('number');\r",
									"    pm.expect(jsonData.id).to.be.above(0);\r",
									"});\r",
									"\r",
									"// Сохраняем ID для последующих тестов\r",
									"const userData = pm.response.json();\r",
									"pm.collectionVariables.set(\"test_user_id\", userData.id);\r",
									"pm.collectionVariables.set(\"test_user_email\", userData.email);\r",
									"pm.collectionVariables.set(\"test_user_name\", userData.name);"
