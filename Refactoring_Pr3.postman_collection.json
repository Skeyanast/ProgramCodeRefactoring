			"name": "Health Checks",
			"item": [
				{
					"name": "API Gateway Health",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Основные проверки статуса\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Gateway reports running status\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.status).to.eql(\"API Gateway is running\");\r",
									"});\r",
									"\r",
									"// Проверка наличия Circuit Breaker'ов\r",
									"pm.test(\"Circuit breakers for all services are present\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.circuits).to.be.an('object');\r",
									"    pm.expect(jsonData.circuits).to.have.property('users');\r",
									"    pm.expect(jsonData.circuits).to.have.property('orders');\r",
									"});\r",
									"\r",
									"// Проверка структуры статистики\r",
									"pm.test(\"Circuit breakers have stats structure\", function () {\r",
									"    const jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.circuits.users.stats).to.be.an('object');\r",
									"    pm.expect(jsonData.circuits.orders.stats).to.be.an('object');\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
